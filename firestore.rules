rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Events: public read.
    // NOTE: Admin dashboard currently performs client-side writes.
    // For production, consider restricting create/update/delete to server-side Admin SDK only.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Bookings: allow client create (with validation). Allow admin reads/updates via client for dashboard.
    match /bookings/{bookingId} {
      allow create: if
        request.resource.data.keys().hasAll(['eventId','name','phone','createdAt','paymentDetails']) &&
        request.resource.data.eventId is string &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.createdAt is string &&
        request.resource.data.paymentDetails is map &&
        (request.resource.data.paymentDetails.status in ['pending','success','failed']) &&
        (
          !('amount' in request.resource.data.paymentDetails) ||
          request.resource.data.paymentDetails.amount is number
        );

      // Allow admins to read/update/delete bookings for management (if using simple admin session).
      allow get, list, update, delete: if true;
    }

    // Error logs - allow writes so client-side error logging works from admin pages.
    match /errorLogs/{logId} {
      allow read: if false;
      allow write: if true;
    }

    // Default: deny everything else to be safe
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
